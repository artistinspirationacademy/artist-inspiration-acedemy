{
    "name": "@workspace/email",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "email:dev": "email dev --dir=src/templates"
    },
    "exports": {
